# Required: Claude API key used for research (web search + fetch) and campaign generation
ANTHROPIC_API_KEY=

# Optional: separate Claude key for the fast chat (falls back to ANTHROPIC_API_KEY)
ANTHROPIC_CHAT_API_KEY=

# Optional model overrides
SCOUT_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-haiku-4-5-20251001

# Optional: require this code in the app before any AI call runs (protects your API spend on a public URL)
ACCESS_CODE=

# Optional: Vercel cron auth for the daily end-of-day scout
CRON_SECRET=

# Optional: PostHog project key for funnel tracking on landing pages
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
